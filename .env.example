# ═══════════════════════════════════════════════════════════════
#  AM Prem.ID — variabel environment
#  Salin ke .env.local (lokal) atau isi di Vercel → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ─── WAJIB DI PRODUKSI ──────────────────────────────────────────
# Kunci HMAC untuk menandatangani magic link & cookie sesi.
# Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=ganti-dengan-32-byte-hex-random

# URL publik aplikasi (dipakai membentuk magic link)
NEXT_PUBLIC_BASE_URL=https://am-prem-id.vercel.app

# ─── PENGIRIMAN EMAIL (opsional, disarankan) ────────────────────
# Tanpa ini: OUTBOX MODE — magic link tampil langsung di UI & di /verify
RESEND_API_KEY=
# Untuk domain sendiri, verifikasi domain di Resend lalu pakai alamatnya.
# Tanpa domain terverifikasi, gunakan: onboarding@resend.dev
MAIL_FROM=AM Prem.ID <no-reply@yourdomain.com>

# ─── PENYIMPANAN PERSISTEN (opsional, disarankan) ───────────────
# Tanpa ini: data disimpan di memori proses → hilang saat cold start Vercel,
# dan rate limit hanya berlaku per-instance (tidak akurat di serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── PANEL ADMIN ────────────────────────────────────────────────
# Wajib untuk membuka /admin dan mencabut lisensi. Kosong = /admin nonaktif (503)
ADMIN_KEY=

# ─── BRANDING (opsional) ────────────────────────────────────────
# Ganti identitas tanpa menyentuh kode
NEXT_PUBLIC_BRAND_NAME=AM Prem.ID
NEXT_PUBLIC_BRAND_DEV=Van313 | Official
# Varian hero: split (default) | headline | banner — lihat /hero-lab
NEXT_PUBLIC_HERO_VARIANT=split

# ─── LAIN-LAIN ──────────────────────────────────────────────────
# Batasi origin API (default *)
ALLOWED_ORIGIN=*
